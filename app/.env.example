# Bootstrap settings only (rules.md 2.1). All other runtime settings live in the database
# and are managed from the admin UI (System Config page).

# Admin login credential.
SYSTEM_SECRET=replace-with-a-long-random-secret

# Used only for AES-256-GCM credential encryption; key is SHA-256(ENCRYPTION_KEY).
ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/7router
