{
  "server": {
    "port": 20131,
    "corsOrigins": ["*"]
  },
  "auth": {
    "adminToken": "replace-with-admin-token",
    "accessTokens": []
  },
  "database": {
    "url": "file:../dev.db"
  },
  "encryption": {
    "keyBase64": "replace-with-32-byte-base64-key"
  },
  "providers": {
    "cloudflareR2": {
      "enabled": true
    },
    "googleDrive": {
      "enabled": true
    }
  },
  "features": {
    "manualSync": true
  }
}
